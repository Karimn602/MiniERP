{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greaz POS Training",
  "mainBinaryName": "GreazPOS-Training",
  "identifier": "com.greazlb.pos.training",
  "build": {
    "beforeDevCommand": "npm run dev:sandbox",
    "beforeBuildCommand": "npm run build:sandbox"
  },
  "app": {
    "windows": [
      {
        "title": "Greaz POS — Training — PRACTICE DATA ONLY",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons-training/32x32.png",
      "icons-training/128x128.png",
      "icons-training/128x128@2x.png",
      "icons-training/icon.icns",
      "icons-training/icon.ico"
    ]
  }
}
